Subject: [PATCH] Add Oplus user data member to StagefrightRecorder

Add mOplusUserData field for OPLUSHDR support.
OnePlus/OPPO patch adding a private member to store HDR-related video recording data.
---
 media/libmediaplayerservice/StagefrightRecorder.h | 1 +
 1 file changed, 1 insertion(+)

diff --git a/media/libmediaplayerservice/StagefrightRecorder.h b/media/libmediaplayerservice/StagefrightRecorder.h
index ee5a1d530b..126c3f74b1 100644
--- a/media/libmediaplayerservice/StagefrightRecorder.h
+++ b/media/libmediaplayerservice/StagefrightRecorder.h
@@ -114,6 +114,7 @@ struct StagefrightRecorder : public MediaRecorderBase {
     void updateMetrics();
 
     AString mLogSessionId;
+    AString mOplusUserData;  // [PATCH OPLUSHDR]
     audio_source_t mAudioSource;
     privacy_sensitive_t mPrivacySensitive;
     video_source mVideoSource;
