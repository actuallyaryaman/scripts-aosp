From f75b8ba0649e542d76dd5f175a54c6c9944d7812 Mon Sep 17 00:00:00 2001
From: elpaablo <donopwhile1@gmail.com>
Date: Mon, 20 Jul 2026 00:52:19 +0100
Subject: [PATCH] sync SR model blobs and symlink the .bin names

Stock ships the SR models as .bin; the vendor tree keeps them as .so prebuilts, so restore the .bin names via device-tree symlinks.
---
 Android.bp            | 18 ++++++++++++++++++
 device.mk             |  5 +++++
 proprietary-files.txt |  3 +++
 3 files changed, 26 insertions(+)

diff --git a/Android.bp b/Android.bp
index 9515b25..d5eb41b 100644
--- a/Android.bp
+++ b/Android.bp
@@ -1,2 +1,20 @@
 soong_namespace {
 }
+
+// The OPlus SR consumers load the models by their stock .bin names, but the
+// vendor tree has to store them as .so so they build as cc_prebuilt_library_shared
+// (ELF files are rejected in PRODUCT_COPY_FILES). Declared here rather than in the
+// vendor tree so re-running extract-files.py doesn't drop them.
+install_symlink {
+    name: "sr_models.bin_symlink",
+    device_specific: true,
+    installed_location: "lib64/sr_models.bin",
+    symlink_target: "sr_models.so",
+}
+
+install_symlink {
+    name: "sr_ref_models.bin_symlink",
+    device_specific: true,
+    installed_location: "lib64/sr_ref_models.bin",
+    symlink_target: "sr_ref_models.so",
+}
diff --git a/device.mk b/device.mk
index 9fe8f6b..a298f3e 100644
--- a/device.mk
+++ b/device.mk
@@ -16,6 +16,11 @@ PRODUCT_COPY_FILES += \
 TARGET_SCREEN_HEIGHT := 2780
 TARGET_SCREEN_WIDTH := 1264
 
+# Camera (SR model .bin names, see Android.bp)
+PRODUCT_PACKAGES += \
+    sr_models.bin_symlink \
+    sr_ref_models.bin_symlink
+
 # Display
 # (no OplusLtpo: the LTPO toggle is superseded by the refresh rate tile —
 #  fixed rates pin the panel via adfr_min_fps, auto = dynamic LTPO;
diff --git a/proprietary-files.txt b/proprietary-files.txt
index 1cef31a..227df8a 100644
--- a/proprietary-files.txt
+++ b/proprietary-files.txt
@@ -1042,6 +1042,7 @@ odm/lib64/libremosaiclib_s5kjn1.so;FIX_SONAME|01d4d61cc30b9a0ec599946c98c6247145
 odm/lib64/librmsclib1.so|c3065ceaaab55bb2b9c5fcc72de332b9282547b4
 odm/lib64/libsaveshaderbin.so|589a6fbd6d8220e074f575d1cff38fea4889c1a8
